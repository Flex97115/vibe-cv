---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ArchitecturePlayground from "../../components/react/ArchitecturePlayground.jsx";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return [
    { params: { lang: "fr" } },
    { params: { lang: "en" } }
  ];
}

const { lang } = Astro.params;
---

<Layout title={lang === "fr" ? "CV - Playgound Architecture" : "CV - Architecture Playground"} lang={lang}>
  <Header lang={lang} />
  
  <main class="container">
    <section class="intro">
      <h1>
        {lang === "fr" ? "Playground d'Architecture" : "Architecture Playground"}
      </h1>
      <p>
        {lang === "fr" 
          ? "Découvrez l'évolution technique et les choix architecturaux de mes expériences majeures d'ingénierie."
          : "Discover the technical evolution and architectural decisions of my major engineering experiences."}
      </p>
    </section>

    <!-- React Flow client component -->
    <ArchitecturePlayground client:load lang={lang} />
  </main>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-md);
  }

  .intro {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  h1 {
    font-size: 2.5rem;
    letter-spacing: -0.05em;
    background: linear-gradient(
      to right,
      var(--color-primary),
      var(--color-secondary)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: var(--spacing-sm);
  }
</style>
