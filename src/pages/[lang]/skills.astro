---
import Layout from "../../layouts/Layout.astro";
import SkillsPage from "../../components/react/SkillsPage.jsx";
import skillsData from "../../data/skills-graph-data.json";

export function getStaticPaths() {
  return [{ params: { lang: "fr" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isFr = lang === "fr";
const cvLink = `${base}/${lang}`;
const title = isFr
  ? `Graphe Compétences — Géry Thrasibule`
  : `Skills Graph — Géry Thrasibule`;
---

<Layout title={title} lang={lang}>
  <!-- System topbar -->
  <div class="topbar no-print">
    <div class="topbar-title">
      ~/cv/skills <span class="slash">/</span>
      <span class="topbar-sub"> géry · toulouse · cto</span>
    </div>
    <a href={cvLink} class="nav-link">← {isFr ? "Retour au CV" : "Back to CV"}</a>
    <div class="spacer"></div>
    <span class="label-muted">LANG</span>
    <div class="seg">
      <a href={`${base}/fr/skills`} class={`seg-btn${isFr ? " on" : ""}`}>FR</a>
      <a href={`${base}/en/skills`} class={`seg-btn${!isFr ? " on" : ""}`}>EN</a>
    </div>
  </div>

  <!-- Skills page (React, full height) -->
  <div class="page-body">
    <SkillsPage
      client:load
      lang={lang}
      data={skillsData}
      cvBase={base}
    />
  </div>
</Layout>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--t-panel);
    border-bottom: 1px solid var(--t-border);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 20px;
    font-size: 12px;
    color: var(--t-dim);
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  .topbar-title {
    font-weight: 600;
    color: var(--t-white);
    font-size: 13px;
    white-space: nowrap;
  }

  .slash {
    color: var(--t-green);
    margin: 0 4px;
  }

  .topbar-sub {
    color: var(--t-dim);
    font-size: 11px;
    font-weight: 400;
  }

  .nav-link {
    color: var(--t-green);
    font-size: 11px;
    letter-spacing: 0.5px;
    padding: 5px 10px;
    border: 1px solid transparent;
    text-decoration: none;
  }

  .nav-link:hover {
    border-color: var(--t-green);
  }

  .spacer { flex: 1; }

  .label-muted {
    color: var(--t-faint);
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  .seg {
    display: inline-flex;
    border: 1px solid var(--t-border);
    background: #fff;
  }

  .seg-btn {
    background: transparent;
    border: none;
    color: var(--t-dim);
    padding: 5px 12px;
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
  }

  .seg-btn.on {
    background: var(--t-green);
    color: #fff;
    font-weight: 700;
  }

  /* React component fills remaining viewport height */
  .page-body {
    height: calc(100vh - 43px);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .topbar-sub { display: none; }

    .page-body {
      height: calc(100vh - 43px);
    }
  }
</style>
