---
interface Props {
  title: string;
  lang: string;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="CV - Géry Thrasibule" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    {
      import.meta.env.PROD && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="d7fb442a-5402-48e3-9de0-8b9310edfd93"
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  :root {
    --t-bg: #f6f4ee;
    --t-panel: #fbfaf5;
    --t-ink: #1a1d20;
    --t-dim: #5a6066;
    --t-faint: #b9bcc0;
    --t-border: #d9d6cc;
    --t-green: #1a7f37;
    --t-green-dim: rgba(26, 127, 55, 0.14);
    --t-amber: #9a6700;
    --t-cyan: #0969a3;
    --t-magenta: #8250df;
    --t-red: #cf222e;
    --t-white: #0a0a0a;

    /* Legacy compat for other pages (skills, architectures) */
    --color-bg: var(--t-bg);
    --color-text: var(--t-ink);
    --color-text-muted: var(--t-dim);
    --color-primary: var(--t-green);
    --color-secondary: var(--t-cyan);
    --color-accent: var(--t-magenta);
    --color-card-bg: var(--t-panel);
    --color-border: var(--t-border);
    --color-bg-offset: var(--t-bg);
    --font-sans: "JetBrains Mono", ui-monospace, Menlo, monospace;
    --font-heading: "JetBrains Mono", ui-monospace, Menlo, monospace;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 2rem;
    --spacing-xl: 4rem;
    --radius-sm: 0.25rem;
    --radius-md: 0.375rem;
    --radius-lg: 0.5rem;
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    background: var(--t-bg);
    color: var(--t-ink);
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    color: var(--t-white);
    margin: 0;
  }

  p { margin: 0; }
  a { color: inherit; text-decoration: none; }

  .term-cursor {
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  @media print {
    @page { size: A4; margin: 10mm; }
    body { background: #fff !important; }
    .no-print { display: none !important; }
  }
</style>
