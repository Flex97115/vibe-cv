---
import Section from "./Section.astro";

interface Props {
  languages: any[];
  title: string;
  lang: string;
}

const { languages, title, lang } = Astro.props;
---

<Section title={title} cmd={`languages --${lang}`}>
  <div class="lang-list">
    {languages.map((l: any) => (
      <div class="lang-item">
        <span class="lang-name">{l.language}</span>
        <span class="lang-level">{l.fluency}</span>
      </div>
    ))}
  </div>
</Section>

<style>
  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .lang-item {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 2px 0;
  }

  .lang-name {
    color: var(--t-white);
  }

  .lang-level {
    color: var(--t-dim);
  }
</style>
