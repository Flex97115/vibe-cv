---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const isFr = lang === "fr";

const metrics = isFr
  ? [
      { value: 6, suffix: "h → 40min", label: "Pipeline data Kocliko", detail: "exécution réduite de 9×" },
      { value: 500, suffix: "k+", label: "Événements / mois", detail: "PTI serverless MerciYanis" },
      { value: 10, suffix: "×", label: "Clients supportés", detail: "migration monolithe → SOA" },
      { value: 15, prefix: "+", suffix: "%", label: "Chiffre d'affaires", detail: "architecture data pharma" },
      { value: 8, suffix: " ans", label: "CTO fondateur", detail: "Le Comptoir Des Pharmacies" },
      { value: 400, suffix: "+", label: "Bases migrées", detail: "bare-metal → PaaS sans downtime" },
    ]
  : [
      { value: 6, suffix: "h → 40min", label: "Kocliko data pipeline", detail: "runtime cut by 9×" },
      { value: 500, suffix: "k+", label: "Events / month", detail: "MerciYanis serverless PTI" },
      { value: 10, suffix: "×", label: "Customers supported", detail: "monolith → SOA migration" },
      { value: 15, prefix: "+", suffix: "%", label: "Revenue uplift", detail: "pharma data architecture" },
      { value: 8, suffix: " yrs", label: "Founding CTO", detail: "Le Comptoir Des Pharmacies" },
      { value: 400, suffix: "+", label: "DBs migrated", detail: "bare-metal → PaaS zero-downtime" },
    ];

const sectionTitle = isFr ? "Impact mesurable" : "Measurable impact";
---

<!-- Section header -->
<div class="sec-header">
  <div class="prompt">
    <span class="arrow">➜</span>
    <span class="path">~/cv</span>
    <span class="cmd">cat impact.log | head -n {metrics.length}</span>
  </div>
  <div class="banner-row">
    <span class="banner-title">{sectionTitle.toUpperCase()}</span>
    <span class="flag">--sorted-by=impact</span>
  </div>
</div>

<!-- Metrics grid -->
<div class="metrics-grid">
  {metrics.map((m, i) => (
    <div class="metric-panel" data-value={m.value} data-prefix={m.prefix || ""} data-suffix={m.suffix}>
      <div class="metric-index">[{String(i + 1).padStart(2, "0")}] {m.label}</div>
      <div class="metric-value">
        <span class="counter">{m.prefix || ""}{m.value}{m.suffix}</span>
      </div>
      <div class="metric-bar">
        <span class="bar-placeholder" data-max="500">[░░░░░░░░░░░░░░░░░░]</span>
      </div>
      <div class="metric-detail"># {m.detail}</div>
    </div>
  ))}
</div>

<style>
  .sec-header {
    margin-top: 56px;
    margin-bottom: 20px;
  }

  .prompt {
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .arrow { color: var(--t-green); font-weight: 600; }
  .path { color: var(--t-cyan); }
  .cmd { color: var(--t-ink); font-weight: 500; }

  .banner-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--t-border);
  }

  .banner-title {
    color: var(--t-panel);
    background: var(--t-green);
    padding: 2px 10px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
  }

  .flag {
    color: var(--t-dim);
    font-size: 12px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--t-border);
    border: 1px solid var(--t-border);
  }

  .metric-panel {
    background: var(--t-panel);
    padding: 18px 20px;
  }

  .metric-index {
    font-size: 11px;
    color: var(--t-dim);
    margin-bottom: 6px;
  }

  .metric-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--t-green);
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .metric-bar {
    margin-top: 10px;
    font-size: 11px;
    color: var(--t-green);
  }

  .metric-detail {
    font-size: 11px;
    color: var(--t-dim);
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media print {
    .sec-header .prompt { display: none; }
    .banner-row { margin-top: 0; }
    .metric-bar { display: none; }
  }
</style>

<script>
  // Animated counters on first paint
  function animateCounters() {
    const panels = document.querySelectorAll<HTMLElement>(".metric-panel");
    panels.forEach((panel) => {
      const valueEl = panel.querySelector<HTMLElement>(".counter");
      if (!valueEl) return;

      const rawValue = panel.dataset.value;
      const target = rawValue ? parseInt(rawValue, 10) : 0;
      const prefix = panel.dataset.prefix || "";
      const suffix = panel.dataset.suffix || "";

      if (isNaN(target)) return;

      const duration = 1200;
      let start: number | null = null;

      function tick(ts: number) {
        if (!start) start = ts;
        const progress = Math.min(1, (ts - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(target * eased);
        valueEl!.textContent = prefix + current + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    });
  }

  // Animated ASCII bars
  function renderBars() {
    const panels = document.querySelectorAll<HTMLElement>(".metric-panel");
    const values = Array.from(panels).map((p) => parseInt(p.dataset.value || "0", 10));
    const maxVal = Math.max(...values);
    const barWidth = 18;

    panels.forEach((panel, i) => {
      const barEl = panel.querySelector<HTMLElement>(".bar-placeholder");
      if (!barEl) return;
      const filled = Math.round((values[i] / maxVal) * barWidth);
      barEl.textContent = "[" + "█".repeat(filled) + "░".repeat(barWidth - filled) + "]";
    });
  }

  renderBars();
  animateCounters();
</script>
