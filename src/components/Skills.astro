---
import Section from "./Section.astro";

interface Props {
  skills: any[];
  skillGroups?: any[];
  title: string;
  lang: string;
}

const { skills, skillGroups, title, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Section title={title} cmd="skills --grouped">
  {skillGroups && skillGroups.length > 0 ? (
    <div class="groups">
      {skillGroups.map((group: any) => (
        <div class="group">
          <div class="group-label">## {group.label}</div>
          <div class="group-items">
            {group.items.map((item: string) => (
              <span class="skill-pill">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="flat-skills">
      {skills.map((s: any) => (
        <a href={`${base}/${lang}/skills?skill=${s.name}`} class="skill-pill">{s.name}</a>
      ))}
    </div>
  )}
</Section>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .group-label {
    color: var(--t-magenta);
    font-size: 11px;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
  }

  .group-items {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .skill-pill {
    font-size: 11px;
    padding: 2px 8px;
    color: var(--t-ink);
    border: 1px solid var(--t-border);
    background: transparent;
    text-decoration: none;
    display: inline-block;
  }

  a.skill-pill:hover {
    border-color: var(--t-green);
    color: var(--t-green);
  }

  .flat-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media print {
    .skill-pill {
      border: 1px solid var(--t-border);
      page-break-inside: avoid;
    }
  }
</style>
