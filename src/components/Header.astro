---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const isFr = lang === "fr";
const homeLink = `${base}/${isFr ? "fr" : "en"}`;
const switchLangLink = `${base}/${isFr ? "en" : "fr"}`;
const skillsLink = `${base}/${lang}/skills`;
const archLink = `${base}/${lang}/architectures`;
const switchLangLabel = isFr ? "EN" : "FR";
---

<header class="header no-print">
  <div class="container">
    <nav>
      <a href={homeLink} class="logo">GT.</a>
      
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <div class="nav-content" id="nav-content">
        <div class="nav-links">
          <a href={skillsLink} class="skills-link">
            {lang === "fr" ? "Graphe Compétences" : "Skills Graph"}
          </a>
          <a href={archLink} class="skills-link">
            Architecture
          </a>
        </div>
        <div class="actions">
          <button
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle theme"
          >
            <!-- Sun icon (for light mode) -->
            <svg
              class="sun-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon (for dark mode) -->
            <svg
              class="moon-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <button
            onclick="window.print()"
            class="print-btn"
            aria-label={isFr ? "Imprimer" : "Print"}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="6 9 6 2 18 2 18 9"></polyline><path
                d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
              ></path><rect x="6" y="14" width="12" height="8"></rect></svg
            >
          </button>
          <a href={switchLangLink} class="lang-switch">
            {switchLangLabel}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    padding: var(--spacing-md) 0;
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-card-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.05em;
    background: var(--color-primary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    color: black; /* Always white for contrast on primary color background */
    text-decoration: none;
    z-index: 101; /* Stay above dropdown */
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem;
    z-index: 101;
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-grow: 1;
    margin-left: var(--spacing-lg);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .actions {
    display: flex;
    gap: var(--spacing-md);
    align-items: center;
  }

  .skills-link {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s;
  }

  .skills-link:hover {
    background: var(--color-bg-offset);
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    width: 40px;
    height: 40px;
  }

  .theme-toggle:hover {
    background: var(--color-card-bg);
    border-color: var(--color-primary);
  }

  /* Show/hide icons based on theme */
  [data-theme="dark"] .sun-icon {
    display: block;
  }

  [data-theme="dark"] .moon-icon {
    display: none;
  }

  [data-theme="light"] .sun-icon {
    display: none;
  }

  [data-theme="light"] .moon-icon {
    display: block;
  }

  .print-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    width: 40px;
    height: 40px;
  }

  .print-btn:hover {
    background: var(--color-card-bg);
    border-color: var(--color-primary);
  }

  .lang-switch {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    transition: all 0.2s;
    text-decoration: none;
    font-weight: 500;
  }

  .lang-switch:hover {
    background: var(--color-card-bg);
    border-color: var(--color-primary);
    color: var(--color-text);
  }

  /* Mobile Responsive Dropdown */
  @media (max-width: 768px) {
    .mobile-menu-btn {
      display: block;
    }

    .nav-content {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-card-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--spacing-md);
      gap: var(--spacing-md);
      margin-left: 0;
      margin-top: 1rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      z-index: 1000;
    }

    .nav-content.active {
      display: flex;
    }
    
    .nav-links {
      flex-direction: column;
      width: 100%;
      align-items: stretch;
    }
    
    .skills-link {
        text-align: center;
        width: 100%;
        padding: 0.75rem;
    }

    .actions {
      justify-content: center;
      width: 100%;
      border-top: 1px solid var(--color-border);
      padding-top: var(--spacing-md);
    }
  }
</style>

<script>
  function initHeader() {
    // Theme toggle functionality
    const themeToggle = document.getElementById("theme-toggle");
    if (themeToggle) {
      themeToggle.onclick = () => {
        const currentTheme = document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      };
    }

    // Mobile Menu toggle functionality
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const navContent = document.getElementById("nav-content");

    if (mobileBtn && navContent) {
      mobileBtn.onclick = () => {
        navContent.classList.toggle("active");
      };
    }
  }

  // Initialize on first load
  initHeader();

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", initHeader);
</script>
