---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isFr = lang === "fr";
const switchLangLink = `${base}/${isFr ? "en" : "fr"}`;
const skillsLink = `${base}/${lang}/skills`;
const archLink = `${base}/${lang}/architectures`;
---

<!-- System topbar -->
<div class="topbar no-print">
  <div class="topbar-title">
    ~/cv <span class="slash">/</span>
    <span class="topbar-sub"> géry · toulouse · cto</span>
  </div>
  <a href={skillsLink} class="nav-link">→ {isFr ? "Graphe Compétences" : "Skills Graph"}</a>
  <a href={archLink} class="nav-link">→ Architecture</a>
  <div class="spacer"></div>
  <span class="label-muted">LANG</span>
  <div class="seg">
    <a href={`${base}/fr`} class={`seg-btn${isFr ? " on" : ""}`}>FR</a>
    <a href={`${base}/en`} class={`seg-btn${!isFr ? " on" : ""}`}>EN</a>
  </div>
  <button class="iconbtn" onclick="window.print()">↓ Print · PDF</button>
</div>

<!-- Terminal window chrome -->
<div class="term-chrome no-print">
  <div class="dots">
    <span class="dot red"></span>
    <span class="dot amber"></span>
    <span class="dot green"></span>
  </div>
  <div class="term-title">
    Géry@cto — ~/cv/{lang} — zsh — 172×48
  </div>
  <div class="online-indicator">
    <span class="online-dot"></span>
    online
  </div>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--t-panel);
    border-bottom: 1px solid var(--t-border);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 20px;
    font-size: 12px;
    color: var(--t-dim);
  }

  .topbar-title {
    font-weight: 600;
    color: var(--t-white);
    font-size: 13px;
    white-space: nowrap;
  }

  .slash {
    color: var(--t-green);
    margin: 0 4px;
  }

  .topbar-sub {
    color: var(--t-dim);
    font-size: 11px;
    font-weight: 400;
  }

  .nav-link {
    color: var(--t-green);
    font-size: 11px;
    letter-spacing: 0.5px;
    padding: 5px 10px;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .nav-link:hover {
    border-color: var(--t-green);
  }

  .spacer {
    flex: 1;
  }

  .label-muted {
    color: var(--t-faint);
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  .seg {
    display: inline-flex;
    border: 1px solid var(--t-border);
    background: #fff;
  }

  .seg-btn {
    background: transparent;
    border: none;
    color: var(--t-dim);
    padding: 5px 12px;
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .seg-btn.on {
    background: var(--t-green);
    color: #fff;
    font-weight: 700;
  }

  .seg-btn:hover:not(.on) {
    color: var(--t-white);
  }

  .iconbtn {
    background: transparent;
    border: 1px solid var(--t-border);
    color: var(--t-white);
    padding: 5px 14px;
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .iconbtn:hover {
    border-color: var(--t-green);
    color: var(--t-green);
  }

  /* Terminal chrome */
  .term-chrome {
    background: var(--t-panel);
    border-bottom: 1px solid var(--t-border);
    display: flex;
    align-items: center;
    padding: 10px 20px;
    gap: 14px;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: block;
  }

  .dot.red { background: #ff5f57; }
  .dot.amber { background: #febc2e; }
  .dot.green { background: #28c840; }

  .term-title {
    color: var(--t-dim);
    font-size: 12px;
    flex: 1;
    text-align: center;
  }

  .online-indicator {
    color: var(--t-green);
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .online-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--t-green);
    box-shadow: 0 0 6px var(--t-green);
  }

  @media (max-width: 640px) {
    .nav-link { display: none; }
    .term-title { font-size: 10px; }
    .topbar-sub { display: none; }
  }
</style>
