---
import Section from "./Section.astro";

interface Props {
  projects: any[];
  title: string;
  lang: string;
}

const { projects, title, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Section title={title} cmd="ls -la ~/projects/" count={projects.length}>
  <div class="projects-grid">
    {projects.map((p: any) => (
      <div class="project">
        <div class="project-header">
          <span class="perm">drwxr-xr-x</span>
          <h3 class="project-name">{p.name}/</h3>
        </div>
        <p class="desc">{p.description}</p>
        <div class="links">
          {p.url && (
            <a href={p.url} target="_blank" rel="noreferrer" class="link">
              → site
            </a>
          )}
          {p.repository && (
            <a href={p.repository} target="_blank" rel="noreferrer" class="link">
              → github
            </a>
          )}
        </div>
        {p.technologies && p.technologies.length > 0 && (
          <div class="tech-list">
            {p.technologies.map((t: string) => (
              <span class="tech-dot">·{t}</span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</Section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .project {
    border: 1px solid var(--t-border);
    background: var(--t-panel);
    padding: 16px 18px;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .perm {
    color: var(--t-dim);
    font-size: 12px;
  }

  .project-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--t-white);
  }

  .desc {
    color: var(--t-ink);
    font-size: 13px;
    margin: 8px 0;
    line-height: 1.55;
  }

  .links {
    display: flex;
    gap: 12px;
    margin-top: 4px;
  }

  .link {
    color: var(--t-cyan);
    font-size: 12px;
  }

  .link:hover {
    text-decoration: underline;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .tech-dot {
    font-size: 10px;
    color: var(--t-dim);
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .project {
      background: transparent;
      border: 1px solid var(--t-border);
      page-break-inside: avoid;
    }

    .project-name { color: var(--t-white); }
  }
</style>
