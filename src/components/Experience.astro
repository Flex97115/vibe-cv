---
import Section from "./Section.astro";

interface Props {
  work: any[];
  title: string;
  lang: string;
}

const { work, title, lang } = Astro.props;
const isFr = lang === "fr";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatDate(dateStr: string) {
  if (!dateStr) return isFr ? "Présent" : "Present";
  const [year, month] = dateStr.split("-");
  if (!month) return year;
  const date = new Date(parseInt(year), parseInt(month) - 1);
  const monthStr = date.toLocaleString(isFr ? "fr-FR" : "en-US", { month: "short" });
  const formatted = monthStr.charAt(0).toUpperCase() + monthStr.slice(1);
  return `${formatted}. ${year}`;
}

function toSlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
}
---

<Section
  title={title}
  cmd="git log --author=gery --since=2016"
  count={work.length}
>
  <div class="work-list">
    {work.map((job: any) => {
      const isCurrent = !job.endDate;
      const slug = toSlug(job.name);
      const commitHash = `${slug}.${job.startDate?.replace(/-/g, "") || ""}`;
      const startFmt = formatDate(job.startDate);
      const endFmt = job.endDate ? formatDate(job.endDate) : (isFr ? "Présent" : "Present");

      return (
        <article class="job">
          <span class:list={["job-dot", { current: isCurrent }]} />
          <div class="commit-line">
            commit {commitHash} —{" "}
            <span class:list={["date-range", { "date-current": isCurrent }]}>
              {startFmt} → {endFmt}
            </span>
          </div>
          <h3 class="job-title">
            {job.logo && (
              <img src={job.logo} alt={job.name} class="company-logo" />
            )}
            {job.name}
            <span class="sep"> / </span>
            <span class="position">{job.position}</span>
          </h3>
          <p class="summary">{job.summary}</p>
          {job.highlights && job.highlights.length > 0 && (
            <ul class="highlights">
              {job.highlights.map((h: string) => (
                <li>
                  <span class="bullet">▸</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}
          {job.technologies && job.technologies.length > 0 && (
            <div class="stack">
              {job.technologies.map((tech: string) => (
                <a href={`${base}/${lang}/skills?skill=${tech}`} class="tech-tag">{tech}</a>
              ))}
            </div>
          )}
        </article>
      );
    })}
  </div>
</Section>

<style>
  .work-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .job {
    position: relative;
    padding-left: 22px;
    border-left: 2px solid var(--t-border);
  }

  .job-dot {
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    background: var(--t-faint);
    border: 2px solid var(--t-bg);
  }

  .job-dot.current {
    background: var(--t-green);
    box-shadow: 0 0 8px var(--t-green);
  }

  .commit-line {
    font-size: 11px;
    color: var(--t-dim);
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }

  .date-range {
    color: var(--t-dim);
  }

  .date-current {
    color: var(--t-green);
  }

  .job-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--t-white);
    letter-spacing: -0.3px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .company-logo {
    height: 20px;
    width: auto;
    max-width: 80px;
    object-fit: contain;
    opacity: 0.9;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .sep {
    color: var(--t-dim);
    font-weight: 400;
  }

  .position {
    color: var(--t-green);
    font-weight: 500;
  }

  .summary {
    color: var(--t-ink);
    margin-top: 6px;
    font-style: italic;
    font-size: 14px;
    line-height: 1.55;
  }

  .highlights {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .highlights li {
    display: flex;
    gap: 10px;
    color: var(--t-ink);
    font-size: 13px;
    line-height: 1.55;
  }

  .bullet {
    color: var(--t-green);
    user-select: none;
    flex-shrink: 0;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .tech-tag {
    font-size: 11px;
    padding: 2px 8px;
    color: var(--t-green);
    background: var(--t-green-dim);
    border: 1px solid var(--t-green-dim);
  }

  .tech-tag:hover {
    border-color: var(--t-green);
  }

  @media print {
    .job {
      border-left: none;
      padding-left: 0;
      page-break-inside: avoid;
    }

    .job-dot { display: none; }
    .commit-line { display: none; }

    .job-title { font-size: 14px; }
    .highlights li { font-size: 12px; }

    .tech-tag {
      background: transparent;
      border: 1px solid var(--t-border);
      color: var(--t-dim);
    }
  }
</style>
