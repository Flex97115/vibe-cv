---
import Section from "./Section.astro";

interface Props {
  education: any[];
  title: string;
}

const { education, title } = Astro.props;
---

<Section title={title} cmd="edu --list">
  <div class="edu-list">
    {education.map((e: any) => (
      <div class="edu-item">
        <div class="year">[{e.endDate || e.startDate}]</div>
        <div class="institution">{e.institution}</div>
        <div class="details">{e.area} · {e.studyType}</div>
      </div>
    ))}
  </div>
</Section>

<style>
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .edu-item {}

  .year {
    color: var(--t-amber);
    font-size: 12px;
  }

  .institution {
    color: var(--t-white);
    font-weight: 600;
    font-size: 14px;
  }

  .details {
    color: var(--t-dim);
    font-size: 13px;
  }

  @media print {
    .edu-item { page-break-inside: avoid; }
  }
</style>
