---
interface Props {
  basics: any;
  lang: string;
}

const { basics, lang } = Astro.props;
const isFr = lang === "fr";
---

<!-- Boot header -->
<pre class="boot-pre"># cv.sh — v2.1.0
# booting profile for Géry...
# [ OK ] identity verified   [ OK ] experience loaded   [ OK ] metrics ready
# ────────────────────────────────────────────────────────────</pre>

<!-- WHO section -->
<div class="who-section">
  <div class="who-grid">
    <!-- Avatar -->
    <div class="avatar">
      <img src="/profile.jpg" alt="Géry Thrasibule" class="avatar-img" />
    </div>

    <!-- Name + role + tagline -->
    <div class="info">
      <div class="prompt-row">
        <span class="arrow">➜</span>
        <span class="path">~</span>
        <span class="cmd">whoami</span>
      </div>
      <h1 class="name">{basics.name}</h1>
      <div class="role-line">
        <span class="dim">$ role → </span>
        <span class="green">{basics.label}</span>
      </div>
      <div class="tagline">"{basics.summary}"</div>
    </div>

    <!-- Contact -->
    <div class="contact">
      <div class="contact-line">
        <span class="magenta">📍</span> {basics.location?.city}, {basics.location?.countryCode}
      </div>
      {basics.email && (
        <div class="contact-line">
          <a href={`mailto:${basics.email}`} class="cyan-link">{basics.email}</a>
        </div>
      )}
      {basics.phone && (
        <div class="contact-line dim">{basics.phone}</div>
      )}
      <div class="profiles">
        {basics.profiles?.map((p: any) => (
          <a href={p.url} target="_blank" rel="noreferrer" class="profile-link">
            {p.network.toLowerCase()}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .boot-pre {
    color: var(--t-dim);
    font-size: 11px;
    line-height: 1.3;
    margin: 32px 0 0;
    white-space: pre;
    overflow: hidden;
    font-family: inherit;
  }

  .who-section {
    margin-top: 32px;
  }

  .who-grid {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 24px;
    align-items: flex-start;
  }

  .avatar {
    width: 84px;
    height: 84px;
    min-width: 84px;
    border: 2px solid var(--t-green);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 0 12px var(--t-green-dim);
  }

  .avatar-img {
    width: 84px;
    height: 84px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .prompt-row {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .arrow { color: var(--t-green); font-weight: 600; }
  .path { color: var(--t-cyan); }
  .cmd { color: var(--t-ink); font-weight: 500; }

  .name {
    font-size: 34px;
    font-weight: 700;
    color: var(--t-white);
    margin: 12px 0 6px;
    letter-spacing: -1px;
  }

  .role-line {
    font-size: 15px;
  }

  .dim { color: var(--t-dim); }
  .green { color: var(--t-green); }

  .tagline {
    color: var(--t-ink);
    font-size: 14px;
    margin-top: 4px;
    font-style: italic;
  }

  .contact {
    text-align: right;
    font-size: 12px;
    color: var(--t-dim);
    line-height: 1.9;
  }

  .contact-line { white-space: nowrap; }

  .magenta { color: var(--t-magenta); }

  .cyan-link {
    color: var(--t-cyan);
  }

  .profiles {
    margin-top: 8px;
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }

  .profile-link {
    color: var(--t-green);
    border-bottom: 1px dotted var(--t-green-dim);
    font-size: 11px;
  }

  .profile-link:hover {
    border-bottom-color: var(--t-green);
  }

  @media (max-width: 640px) {
    .who-grid {
      grid-template-columns: 56px 1fr;
      gap: 16px;
    }

    .contact {
      grid-column: 1 / -1;
      text-align: left;
    }

    .profiles {
      justify-content: flex-start;
    }

    .name { font-size: 26px; }
  }

  @media print {
    .boot-pre { display: none; }

    .name { font-size: 26px; }

    .who-grid {
      grid-template-columns: 56px 1fr auto;
    }

    .prompt-row { display: none; }
  }
</style>
