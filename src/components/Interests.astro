---
import Section from "./Section.astro";

interface Props {
  interests: any[];
  title: string;
}

const { interests, title } = Astro.props;
---

<Section title={title} cmd="afk --reasons">
  <div class="interests">
    {interests.map((item: any, i: number) => (
      <>
        <span class="gt">{">"}</span>
        <span class="interest-name">{item.name}</span>
        {i < interests.length - 1 && <span class="sep">  ·  </span>}
      </>
    ))}
  </div>
</Section>

<style>
  .interests {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    font-size: 13px;
    color: var(--t-ink);
  }

  .gt {
    color: var(--t-green);
  }

  .sep {
    color: var(--t-faint);
  }
</style>
